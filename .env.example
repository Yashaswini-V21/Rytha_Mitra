OPENWEATHER_ONECALL_URL=https://api.openweathermap.org/data/3.0/onecall

# -------------------------------
# Translation (Bhashini)
# -------------------------------
BHASHINI_API_URL=
BHASHINI_API_KEY=

# -------------------------------
# Mandi Prices (Agmarknet)
# -------------------------------
AGMARKNET_API_URL=
AGMARKNET_API_KEY=
AGMARKNET_API_TOKEN=
AGMARKNET_AUTH_HEADER=Authorization
