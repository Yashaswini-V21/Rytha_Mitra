# -------------------------------
# Core LLM (Groq LLaMA)
# -------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2

# -------------------------------
# Weather (OpenWeatherMap)
# -------------------------------
