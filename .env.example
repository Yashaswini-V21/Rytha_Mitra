# -----------------------------------------------
# RythaGelathi — Environment Configuration
# -----------------------------------------------

# -------------------------------
# Core LLM (Groq LLaMA) — REQUIRED
# -------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2

# -------------------------------
# Weather (OpenWeatherMap) — REQUIRED for live weather
# -------------------------------
OPENWEATHER_API_KEY=
OPENWEATHER_GEO_URL=https://api.openweathermap.org/geo/1.0/direct
OPENWEATHER_ONECALL_URL=https://api.openweathermap.org/data/3.0/onecall

# -------------------------------
# Voice & Translation (Sarvam AI) — REQUIRED for Kannada output
# Get your key at: https://www.sarvam.ai/
# -------------------------------
SARVAM_API_KEY=

# -------------------------------
# Mandi Prices (Agmarknet) — Optional, falls back to static JSON
# -------------------------------
AGMARKNET_API_URL=
AGMARKNET_API_KEY=
AGMARKNET_API_TOKEN=
AGMARKNET_AUTH_HEADER=Authorization
AGMARKNET_STATIC_PATH=tools/Karnataka_mandi_prices.json

# -------------------------------
# Local Data Paths
# -------------------------------
CROP_DATASET_PATH=data/crop_dataset.csv
KARNATAKA_SOIL_JSON_PATH=data/karnataka_soil_health.json
CROP_YIELD_MAP_PATH=

# -------------------------------
# Flask Server
# -------------------------------
API_HOST=0.0.0.0
API_PORT=8000
